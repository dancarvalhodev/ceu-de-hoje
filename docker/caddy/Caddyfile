# SITE_ADDRESS: ":80" in dev; the domain in production, which turns on automatic HTTPS.
# http://127.0.0.1 keeps plain HTTP for the container healthcheck in both.
{$SITE_ADDRESS}, http://127.0.0.1 {
	root * /var/www/html/public

	log

	# /login/ -> /login, unless the path is a real file
	@trailingSlash {
		path_regexp withSlash ^/(.+)/$
		not file
	}
	redir @trailingSlash /{re.withSlash.1} 301

	@hidden path */.ht*
	respond @hidden 403

	php_fastcgi php:9000

	file_server
}
