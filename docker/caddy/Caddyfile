# Keep the edge proxy's X-Forwarded-* headers (it reaches us from a private Docker network)
{
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	root * /var/www/html/public

	log

	# /login/ -> /login, unless the path is a real file
	@trailingSlash {
		path_regexp withSlash ^/(.+)/$
		not file
	}
	redir @trailingSlash /{re.withSlash.1} 301

	@hidden path */.ht*
	respond @hidden 403

	php_fastcgi php:9000

	file_server
}
